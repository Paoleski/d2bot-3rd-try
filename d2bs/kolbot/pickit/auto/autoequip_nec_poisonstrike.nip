[type] == belt && [quality] <= rare # [fhr] >= 10 && [fireresist]+[lightresist] >= 20 # [tier] == 115
[name] == platedbelt && [quality] == set # [fireresist] == 20 # [tier] == 100 // Sigon's Warp

// =============================================================================
// AMULET — Angelics / life / AR / resists / necro skills (not FCR)
// =============================================================================
[type] == amulet && [quality] == set # [itemdamagetomana] == 20 # [maxquantity] == 1 && [tier] == 125 // Angelic Wings
[type] == amulet && [quality] <= rare # [tohit] >= 50 # [tier] == 90
[type] == amulet && [quality] <= rare # [tohit] >= 100 # [tier] == 105

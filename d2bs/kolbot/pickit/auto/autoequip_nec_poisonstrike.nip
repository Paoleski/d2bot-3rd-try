// Necromancer POISON STRIKE — melee AutoEquip overlay
// https://wiki.projectdiablo2.com/wiki/Starter_Poison_Strike_Necromancer
// IAS FIRST (aim 35+, prefer 58). Then FHR / resists / life / AR / ED. Do NOT chase FCR.
// Loaded via Config.AutoGearBuild = "poisonstrike" (max tier wins over class nip).

// =============================================================================
// WEAPON — knife only (PS); on-weapon IAS is king, then +Poison Strike
// =============================================================================
[type] == knife && [quality] <= superior # # [tier] == 100
[type] == knife && [quality] == magic # # [tier] == 108
[type] == knife && [quality] == rare # # [tier] == 112
// IAS alone beats plain rare/magic
[type] == knife && [quality] <= rare # [ias] >= 10 # [tier] == 140
[type] == knife && [quality] <= rare # [ias] >= 20 # [tier] == 150
[type] == knife && [quality] <= rare # [ias] >= 30 # [tier] == 158
// +PS without IAS — good, but loses to same skill WITH IAS
[type] == knife && [quality] <= rare # [skillpoisondagger] >= 1 # [tier] == 130
[type] == knife && [quality] <= rare # [skillpoisondagger] >= 2 # [tier] == 138
[type] == knife && [quality] <= rare # [skillpoisondagger] >= 3 # [tier] == 145
[type] == knife && [quality] <= rare # [skillpoisondagger] >= 1 && [ias] >= 10 # [tier] == 160
[type] == knife && [quality] <= rare # [skillpoisondagger] >= 2 && [ias] >= 10 # [tier] == 168
[type] == knife && [quality] <= rare # [skillpoisondagger] >= 3 && [ias] >= 10 # [tier] == 175
[type] == knife && [quality] <= rare # [skillpoisondagger] >= 2 && [ias] >= 20 # [tier] == 178
[type] == knife && [quality] <= rare # [skillpoisondagger] >= 3 && [ias] >= 20 # [tier] == 185
[type] == knife && [flag] == runeword # [itemcrushingblow] >= 25 # [tier] == 128 // Strength (no IAS — mid)

[name] == kris && [quality] == unique # [skillpoisondagger] >= 2 # [maxquantity] == 1 && [tier] == 170 // Jade Tan Do (Shael socket)
[name] == cinquedeas && [quality] == unique # [ias] >= 30 && [skillpoisondagger] >= 2 # [maxquantity] == 1 && [tier] == 190 // Blackbog's

// =============================================================================
// OFFHAND — +Poison Strike heads/shields; else block / resists / FHR / defense
// =============================================================================
[type] == head && [quality] <= rare # [skillpoisondagger] >= 1 # [tier] == 100
[type] == head && [quality] <= rare # [skillpoisondagger] >= 2 # [tier] == 115
[type] == head && [quality] <= rare # [skillpoisondagger] >= 3 # [tier] == 130
[type] == head && [quality] <= rare # [fireresist]+[lightresist]+[coldresist] >= 20 # [tier] == 70
[type] == head && [quality] <= rare # [fireresist]+[lightresist]+[coldresist] >= 40 # [tier] == 85
[type] == head && [quality] <= rare # [fhr] >= 10 # [tier] == 75
[type] == head && [quality] <= rare # [enhanceddefense] >= 30 # [tier] == 65

[type] == shield && [type] != auricshields && [quality] <= rare # [skillpoisondagger] >= 1 # [tier] == 95
[type] == shield && [type] != auricshields && [quality] <= rare # [skillpoisondagger] >= 2 # [tier] == 110
[type] == shield && [type] != auricshields && [quality] <= rare # [skillpoisondagger] >= 3 # [tier] == 125
[type] == shield && [type] != auricshields && [quality] <= rare # [fireresist]+[lightresist]+[coldresist] >= 30 # [tier] == 70
[type] == shield && [type] != auricshields && [quality] <= rare # [fireresist]+[lightresist]+[coldresist] >= 50 # [tier] == 90
[type] == shield && [type] != auricshields && [quality] <= rare # [fhr] >= 10 # [tier] == 75
[type] == shield && [type] != auricshields && [quality] <= rare # [fbr] >= 20 # [tier] == 80
[type] == shield && [type] != auricshields && [quality] <= rare # [enhanceddefense] >= 40 # [tier] == 65
[type] == shield && [type] != auricshields && [quality] <= rare # [enhanceddamage] >= 20 # [tier] == 85
[type] == shield && [type] != auricshields && [quality] <= rare # [enhanceddamage] >= 40 # [tier] == 100
[type] == shield && [type] != auricshields && [quality] <= rare # [enhanceddamage] >= 80 # [tier] == 115
[type] == shield && [type] != auricshields && [quality] <= rare # [enhanceddamage] >= 40 && [fireresist]+[lightresist] >= 30 # [tier] == 120


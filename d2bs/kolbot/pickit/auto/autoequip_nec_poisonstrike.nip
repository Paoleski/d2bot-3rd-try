[type] == boots && [quality] <= rare # [ias] >= 10 && [fireresist]+[lightresist] >= 10 # [tier] == 120

// =============================================================================
// BELT — FHR / IAS / life / resists (not caster mana)
// =============================================================================
[type] == belt && [quality] <= rare # [fhr] >= 10 # [tier] == 90
[type] == belt && [quality] <= rare # [fhr] >= 20 # [tier] == 105
[type] == belt && [quality] <= rare # [ias] >= 10 # [tier] == 95
[type] == belt && [quality] <= rare # [maxhp] >= 30 # [tier] == 85
[type] == belt && [quality] <= rare # [maxhp] >= 40 # [tier] == 100

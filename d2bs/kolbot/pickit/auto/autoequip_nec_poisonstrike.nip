[type] == amulet && [quality] <= rare # [maxhp] >= 20 && [fireresist]+[lightresist] >= 20 # [tier] == 118
[type] == amulet && [quality] <= rare # [necromancerskills] >= 1 # [tier] == 120
[type] == amulet && [quality] <= rare # [necromancerskills] >= 2 # [tier] == 130

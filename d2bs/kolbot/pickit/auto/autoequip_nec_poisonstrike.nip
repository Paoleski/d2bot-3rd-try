[type] == amulet && [quality] == unique # [fireresist] >= 50 # [tier] == 100
// No FCR amulet floors — melee PS; Misc.isMeleeJunkFcrJewelry sells FCR-only jewelry

// =============================================================================
// RINGS — Angelics / life / AR / resists
// =============================================================================
[type] == ring && [quality] == magic # # [tier] == 20
[type] == ring && [quality] == rare # # [tier] == 25
[type] == ring && [quality] == set # [maxhp] == 20 # [maxquantity] == 2 && [tier] == 125 // Angelic Halo
[type] == ring && [quality] <= rare # [tohit] >= 50 # [tier] == 90
[type] == ring && [quality] <= rare # [tohit] >= 100 # [tier] == 105
[type] == ring && [quality] <= rare # [maxhp] >= 20 # [tier] == 95
[type] == ring && [quality] <= rare # [maxhp] >= 40 # [tier] == 115
[type] == ring && [quality] <= rare # [fireresist]+[lightresist]+[coldresist] >= 20 # [tier] == 90
[type] == ring && [quality] <= rare # [fireresist]+[lightresist]+[coldresist] >= 30 # [tier] == 110
[type] == ring && [quality] <= rare # [maxhp] >= 20 && [tohit] >= 50 # [tier] == 120
[type] == ring && [quality] <= rare # [maxhp] >= 20 && [fireresist]+[lightresist] >= 20 # [tier] == 122
[type] == ring && [quality] <= rare # [lifeleech] >= 3 # [tier] == 100
[type] == ring && [quality] <= rare # [strength]+[dexterity] >= 10 # [tier] == 85
// No FCR ring floors — base nec.nip FCR rings blocked by Misc.isMeleeJunkFcrJewelry

// =============================================================================
// JEWELS / CHARMS — IAS fillers toward 35/58 breakpoints (keep, no #tier)
// =============================================================================
[type] == jewel && [quality] == magic # [ias] >= 15
[type] == jewel && [quality] == rare # [ias] >= 15
[type] == jewel && [quality] == magic # [ias] >= 10 && [maxhp] >= 10
[type] == smallcharm && [quality] == magic # [ias] >= 5
[type] == mediumcharm && [quality] == magic # [ias] >= 7
[type] == largecharm && [quality] == magic # [ias] >= 10
[name] == cm1 && [quality] == magic # [ias] >= 5
[name] == cm2 && [quality] == magic # [ias] >= 7
[name] == cm3 && [quality] == magic # [ias] >= 10

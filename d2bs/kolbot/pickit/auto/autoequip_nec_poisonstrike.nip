[type] == armor && [quality] <= rare # [enhanceddefense] >= 80 # [tier] == 85
[type] == armor && [quality] <= rare # [fhr] >= 10 # [tier] == 80
[type] == armor && [quality] <= rare # [maxhp] >= 30 && [fireresist]+[lightresist] >= 20 # [tier] == 95
[type] == armor && [quality] <= rare # [enhanceddefense] >= 50 && [fireresist]+[lightresist] >= 20 # [tier] == 100

// =============================================================================
// GLOVES — Sigon's / IAS (beat Magefist FCR)
// =============================================================================
[name] == gauntlets && [quality] == set # [strength] > 10 # [maxquantity] == 1 && [tier] == 130 // Sigon's Gage
[type] == gloves && [quality] <= rare # [ias] >= 10 # [tier] == 100
[type] == gloves && [quality] <= rare # [ias] >= 20 # [tier] == 115
[type] == gloves && [quality] <= rare # [ias] >= 10 && [fireresist]+[lightresist] >= 10 # [tier] == 120
[type] == gloves && [quality] <= rare # [fireresist]+[lightresist]+[coldresist] >= 20 # [tier] == 80
[type] == gloves && [quality] <= rare # [strength]+[dexterity] >= 10 # [tier] == 75
[type] == gloves && [quality] <= rare # [maxhp] >= 10 # [tier] == 70
// Demote FCR gloves (Magefist etc.) below IAS
[type] == gloves && [quality] == unique # [fcr] > 0 # [tier] == 40

// =============================================================================
// BOOTS — Sigon's / IAS / FHR / resists / FRW
// =============================================================================
[name] == greaves && [quality] == set # # [maxquantity] == 1 && [tier] == 130 // Sigon's Sabot
[type] == boots && [quality] <= rare # [ias] >= 10 # [tier] == 100
[type] == boots && [quality] <= rare # [ias] >= 20 # [tier] == 115
[type] == boots && [quality] <= rare # [fhr] >= 10 # [tier] == 95

// Necromancer POISON STRIKE — melee AutoEquip overlay
// https://wiki.projectdiablo2.com/wiki/Starter_Poison_Strike_Necromancer
// Prioritize IAS / FHR / resists / defense / life / AR. Do NOT chase FCR.
// Loaded via Config.AutoGearBuild = "poisonstrike" (max tier wins over class nip).

// =============================================================================
// WEAPON — knife only (PS); +skill / IAS
// =============================================================================
[type] == knife && [quality] <= superior # # [tier] == 100
[type] == knife && [quality] == magic # # [tier] == 110
[type] == knife && [quality] == rare # # [tier] == 115
[type] == knife && [quality] <= rare # [ias] >= 10 # [tier] == 118
[type] == knife && [quality] <= rare # [ias] >= 20 # [tier] == 122
[type] == knife && [quality] <= rare # [skillpoisondagger] >= 1 # [tier] == 125
[type] == knife && [quality] <= rare # [skillpoisondagger] >= 2 # [tier] == 130
[type] == knife && [quality] <= rare # [skillpoisondagger] >= 3 # [tier] == 135
[type] == knife && [quality] <= rare # [skillpoisondagger] >= 1 && [ias] >= 10 # [tier] == 132
[type] == knife && [quality] <= rare # [skillpoisondagger] >= 2 && [ias] >= 10 # [tier] == 138
[type] == knife && [quality] <= rare # [skillpoisondagger] >= 3 && [ias] >= 10 # [tier] == 142

[name] == kris && [quality] == unique # [skillpoisondagger] >= 2 # [maxquantity] == 1 && [tier] == 145 // Jade Tan Do
[name] == cinquedeas && [quality] == unique # [ias] >= 30 && [skillpoisondagger] >= 2 # [maxquantity] == 1 && [tier] == 150 // Blackbog's

// =============================================================================
// OFFHAND — +Poison Strike heads/shields; else block / resists / FHR / defense
// =============================================================================
[type] == head && [quality] <= rare # [skillpoisondagger] >= 1 # [tier] == 100
[type] == head && [quality] <= rare # [skillpoisondagger] >= 2 # [tier] == 115
[type] == head && [quality] <= rare # [skillpoisondagger] >= 3 # [tier] == 130
[type] == head && [quality] <= rare # [fireresist]+[lightresist]+[coldresist] >= 20 # [tier] == 70
[type] == head && [quality] <= rare # [fireresist]+[lightresist]+[coldresist] >= 40 # [tier] == 85
[type] == head && [quality] <= rare # [fhr] >= 10 # [tier] == 75
[type] == head && [quality] <= rare # [enhanceddefense] >= 30 # [tier] == 65

[type] == shield && [quality] <= rare # [skillpoisondagger] >= 1 # [tier] == 95
[type] == shield && [quality] <= rare # [skillpoisondagger] >= 2 # [tier] == 110
[type] == shield && [quality] <= rare # [skillpoisondagger] >= 3 # [tier] == 125
[type] == shield && [quality] <= rare # [fireresist]+[lightresist]+[coldresist] >= 30 # [tier] == 70
[type] == shield && [quality] <= rare # [fireresist]+[lightresist]+[coldresist] >= 50 # [tier] == 90
[type] == shield && [quality] <= rare # [fhr] >= 10 # [tier] == 75
[type] == shield && [quality] <= rare # [fbr] >= 20 # [tier] == 80
[type] == shield && [quality] <= rare # [enhanceddefense] >= 40 # [tier] == 65

// =============================================================================
// HELM — Wormskull; else FHR / resists / defense / life (not FCR circlets)
// =============================================================================
[name] == bonehelm && [quality] == unique # [necromancerskills] >= 1 && [lifeleech] >= 5 # [maxquantity] == 1 && [tier] == 120 // Wormskull
[type] == helm && [flag] == runeword # [lightresist] >= 25 # [tier] == 95 // Lore (res)
[type] == helm && [quality] <= rare # [fhr] >= 10 # [tier] == 70
[type] == helm && [quality] <= rare # [fhr] >= 20 # [tier] == 85
[type] == helm && [quality] <= rare # [ias] >= 10 # [tier] == 75
[type] == helm && [quality] <= rare # [maxhp] >= 20 # [tier] == 70
[type] == helm && [quality] <= rare # [fireresist]+[lightresist]+[coldresist] >= 20 # [tier] == 75
[type] == helm && [quality] <= rare # [fireresist]+[lightresist]+[coldresist] >= 40 # [tier] == 90
[type] == helm && [quality] <= rare # [enhanceddefense] >= 40 # [tier] == 65
[type] == helm && [quality] <= rare # [enhanceddefense] >= 80 # [tier] == 80
[type] == helm && [quality] <= rare # [fhr] >= 10 && [fireresist]+[lightresist] >= 20 # [tier] == 95
[type] == helm && [quality] <= rare # [maxhp] >= 20 && [fireresist]+[lightresist] >= 20 # [tier] == 100

// =============================================================================
// ARMOR — Stealth (FHR); else defense / resists / life (ignore FCR)
// =============================================================================
[type] == armor && [flag] == runeword # [fhr] == 30 # [tier] == 100 // Stealth — FHR for melee
[type] == armor && [quality] <= rare # [maxhp] >= 20 # [tier] == 70
[type] == armor && [quality] <= rare # [maxhp] >= 40 # [tier] == 85

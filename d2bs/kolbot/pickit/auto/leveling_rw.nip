// Shared leveling RW bases (Stealth / Lore). Class-specific bases load separately:
//   auto/leveling_rw_leaf.nip  — sorc Leaf staves
//   auto/leveling_rw_steel.nip — melee Steel swords/axes
// Runes via auto/all_runes.nip.
//
// Stealth (Tal+Eth): non-eth 2os armor with real defense (Ring Mail+).
// Quilted/Leather/Studded never reach ~40 def — do not pick those as Stealth bases.

// Stealth — named bases that can roll defense >= 40
([Name] == RingMail || [Name] == ScaleMail || [Name] == BreastPlate || [Name] == ChainMail || [Name] == SplintMail || [Name] == GhostArmor || [Name] == SerpentskinArmor || [Name] == DemonhideArmor || [Name] == TrellisedArmor || [Name] == LinkedMail || [Name] == TigulatedMail || [Name] == Cuirass) && [Flag] != Ethereal && [quality] <= superior # [Sockets] == 2 && [defense] >= 40

// Stealth — any 2os armor that already has 40+ defense (shop/field catch-all)
[Type] == Armor && [Flag] != Ethereal && [quality] <= superior # [Sockets] == 2 && [defense] >= 40

// Lore (Ort+Sol) — 2os helms
([Name] == Cap || [Name] == SkullCap || [Name] == Helm || [Name] == FullHelm || [Name] == Mask || [Name] == BoneHelm || [Name] == Sallet || [Name] == Casque || [Name] == Basinet) && [Flag] != Ethereal && [quality] <= superior # [Sockets] == 2

// Early leveling filler charms — keep until better ones replace them.
// Inventory bottom rows = charm zone (Town.applyCharmInventoryLock).
// PD2 types: smallcharm=83, mediumcharm=84 (Large), largecharm=85 (Grand).
// Unid charms: pick to ID (Town forces ID before sell). Keep lines below are IDENTIFIED only.
// After ID, charms that miss these keep lines are sold (Town.sellAllBadCharms).
// Sell gate uses THIS file only (not kolton). Be generous while inv is empty.

// --- Unidentified magic charms (pick only — never used as keep rules) ---
[type] == smallcharm && [quality] == magic && [flag] != identified
[type] == mediumcharm && [quality] == magic && [flag] != identified
[type] == largecharm && [quality] == magic && [flag] != identified
[name] == cm1 && [quality] == magic && [flag] != identified
[name] == cm2 && [quality] == magic && [flag] != identified
[name] == cm3 && [quality] == magic && [flag] != identified

// =============================================================================
// Small Charms (1x1) — identified keep
// =============================================================================
// Any single resist > 6
[type] == smallcharm && [quality] == magic # [fireresist] >= 7
[type] == smallcharm && [quality] == magic # [coldresist] >= 7
[type] == smallcharm && [quality] == magic # [lightresist] >= 7
[type] == smallcharm && [quality] == magic # [poisonresist] >= 7
[type] == smallcharm && [quality] == magic # [coldresist]+[fireresist]+[lightresist]+[poisonresist] >= 10
// Life / mana (loose for empty inv)
[type] == smallcharm && [quality] == magic # [maxhp] >= 10
[type] == smallcharm && [quality] == magic # [maxmana] >= 10
// Movement / recovery
[type] == smallcharm && [quality] == magic # [frw] >= 3
[type] == smallcharm && [quality] == magic # [fhr] >= 5
// Combos (even weaker singles if paired)
[type] == smallcharm && [quality] == magic # [maxhp] >= 8 && ([fireresist] >= 5 || [coldresist] >= 5 || [lightresist] >= 5 || [maxmana] >= 8)
[type] == smallcharm && [quality] == magic # [frw] >= 3 && ([maxhp] >= 8 || [maxmana] >= 8 || [fireresist]+[coldresist]+[lightresist] >= 6)
[type] == smallcharm && [quality] == magic # [fhr] >= 5 && ([maxhp] >= 8 || [maxmana] >= 8)
// MF / gold (stash filler while leveling)
[type] == smallcharm && [quality] == magic # [itemmagicbonus] >= 5
[type] == smallcharm && [quality] == magic # [itemgoldbonus] >= 10

// =============================================================================
// Large Charms (2x1) — NTIP type is mediumcharm
// =============================================================================
[type] == mediumcharm && [quality] == magic # [fireresist] >= 7
[type] == mediumcharm && [quality] == magic # [coldresist] >= 7
[type] == mediumcharm && [quality] == magic # [lightresist] >= 7
[type] == mediumcharm && [quality] == magic # [poisonresist] >= 7
[type] == mediumcharm && [quality] == magic # [coldresist]+[fireresist]+[lightresist]+[poisonresist] >= 12
[type] == mediumcharm && [quality] == magic # [maxhp] >= 15
[type] == mediumcharm && [quality] == magic # [maxmana] >= 15
[type] == mediumcharm && [quality] == magic # [frw] >= 5
[type] == mediumcharm && [quality] == magic # [fhr] >= 8
[type] == mediumcharm && [quality] == magic # [frw] >= 5 && ([maxhp] >= 12 || [maxmana] >= 12)
[type] == mediumcharm && [quality] == magic # [fhr] >= 8 && ([maxhp] >= 12 || [maxmana] >= 12)
[type] == mediumcharm && [quality] == magic # [itemmagicbonus] >= 5
[name] == cm2 && [quality] == magic # [maxhp] >= 15
[name] == cm2 && [quality] == magic # [maxmana] >= 15
[name] == cm2 && [quality] == magic # [fireresist] >= 7 || [coldresist] >= 7 || [lightresist] >= 7

// =============================================================================
// Grand Charms (2x3) — NTIP type is largecharm — sorc leveling priorities
// =============================================================================
// Any single resist > 6
[type] == largecharm && [quality] == magic # [fireresist] >= 7
[type] == largecharm && [quality] == magic # [coldresist] >= 7
[type] == largecharm && [quality] == magic # [lightresist] >= 7
[type] == largecharm && [quality] == magic # [poisonresist] >= 7
[type] == largecharm && [quality] == magic # [coldresist]+[fireresist]+[lightresist]+[poisonresist] >= 12
// Life / mana
[type] == largecharm && [quality] == magic # [maxhp] >= 15
[type] == largecharm && [quality] == magic # [maxmana] >= 20
// FRW / FHR
[type] == largecharm && [quality] == magic # [frw] >= 7
[type] == largecharm && [quality] == magic # [fhr] >= 12
// Sorc skill tabs / class skills (any element — build-agnostic keep)
[type] == largecharm && [quality] == magic # [fireskilltab] >= 1
[type] == largecharm && [quality] == magic # [coldskilltab] >= 1
[type] == largecharm && [quality] == magic # [lightningskilltab] >= 1
[type] == largecharm && [quality] == magic # [sorceressskills] >= 1
[type] == largecharm && [quality] == magic # [fireskilltab]+[coldskilltab]+[lightningskilltab] >= 1
// Energy (helps early mana pool)
[type] == largecharm && [quality] == magic # [energy] >= 5
[type] == largecharm && [quality] == magic # [itemmagicbonus] >= 5
[name] == cm3 && [quality] == magic # [maxhp] >= 15
[name] == cm3 && [quality] == magic # [maxmana] >= 20
[name] == cm3 && [quality] == magic # [fireresist] >= 7 || [coldresist] >= 7 || [lightresist] >= 7
[name] == cm3 && [quality] == magic # [coldskilltab] >= 1 || [fireskilltab] >= 1 || [lightningskilltab] >= 1 || [sorceressskills] >= 1
[name] == grandcharm && [quality] == magic # [maxhp] >= 15
[name] == grandcharm && [quality] == magic # [maxmana] >= 20
[name] == grandcharm && [quality] == magic # [coldskilltab] >= 1 || [fireskilltab] >= 1 || [lightningskilltab] >= 1

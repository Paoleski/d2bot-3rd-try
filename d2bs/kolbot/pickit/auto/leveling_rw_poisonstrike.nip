// Poison Strike merc sticks: Purity (Amn+Eth+Thul, 3os) > Strength (Amn+Tir, 2os).
// Necro knives never get these — shop/drop +PS / IAS instead.
// Nip MaxQuantity alone is weak (spear vs polearm lines; stash vs inv).
// Pickit + cull: at most one best empty 3os; ignore all 2os/3os once Purity/Insight is done.

[type] == spear && [Flag] != Ethereal && [quality] <= superior # [Sockets] == 3 # [MaxQuantity] == 1
[type] == polearm && [Flag] != Ethereal && [quality] <= superior # [Sockets] == 3 # [MaxQuantity] == 1
[type] == spear && [Flag] != Ethereal && [quality] <= superior # [Sockets] == 2 # [MaxQuantity] == 1
[type] == polearm && [Flag] != Ethereal && [quality] <= superior # [Sockets] == 2 # [MaxQuantity] == 1
